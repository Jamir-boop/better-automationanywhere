// Actions and variables sidebar
// hide the contents of the non active toolbars
.editor-palette__accordion:not(.editor-palette__accordion--is_active)
	.editor-palette-section__scroller
			display: none
	// make the header text smaller
	span.editor-palette-section__header-title
		font-size: 10px
		font-weight: normal
		:hover
			font-weight: bold

	.editor-palette-section__action-search,
	.editor-palette-section__header-button
		padding-inline: 0px

.editor-palette
	span.editor-palette-section__header-title
		font-size: 1rem

	flex-direction: row
	&-section__scroller
		display: block
	&__accordion
		//all: unset
		//flex: 0 0 3px important

		&--is_active
			background: red !important
			display: block

	&-section__header-show
		display: none

	//hide the scrollbars
	&-section__scroller
		overflow-y: auto
		scrollbar-width: none // For Firefox
		&::-webkit-scrollbar
			display: none // For Chrome, Safari, and Opera
	&-section__header-actions
		z-index: 999
		margin-top: 45px

	// mueve boton de limpiar busqueda a la derecha
	&-search__cancel
		right: 100%

// Hides the non active palettes
.editor-palette__accordion--is_active
	flex: 1 0 1px !important

.editor-palette__accordion
	flex-basis: 0px !important
	transition none
.editor-palette span.editor-palette-section__header-title
	color white

.editor-palette-section__header
	height 0px !important
.editor-palette-section__header-inner
	height 12px !important

.editor-palette-section__scroller--variant_search
	margin-top -30px !important
.editor-palette-section__scroller-top
	background transparent !important

#customActionVariableButtons
	display: flex
	width: 100%
	height: 38px !important
	background: white

	button
		all: unset
		display: inline-flex
		align-items: center
		justify-content: center
		font-size: .85rem
		font-weight: 300
		cursor: pointer
		margin: 4px
		border-radius: 5px
		border: 1px solid transparent
		background-color: transparent
		color: #3c5e83
		flex-grow: 1
		text-align: center
		transition: background-color .3s

		&:hover
			background-color: #dae9f3

	.better-aa-icon
		width: 15px !important
		height: 15px !important

.buttonToolbarActive
	border: 1px solid #3c5e83 !important
	text-shadow: .5px 0 0 #3c5e83, -.01px 0 0 #3c5e83 !important

.editor-palette.g-box-sizing_border-box
	margin-top: 38px
